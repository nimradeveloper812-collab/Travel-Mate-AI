# Database Connection (defaults to SQLite if left empty)
DATABASE_URL=sqlite:///./travelmate.db

# JWT Secret Key
SECRET_KEY=travelmate-super-secret-jwt-key-replace-in-production

# Google Gemini API Key (for LLM trip generation & AI chat)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenWeatherMap API Key (for real-time weather & packing insights)
# Get a key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# RapidAPI Skyscraper API Key (for flight routes & hotel destinations)
# Get a key at: https://rapidapi.com/apiheavens/api/sky-scrapper
RAPIDAPI_KEY=
